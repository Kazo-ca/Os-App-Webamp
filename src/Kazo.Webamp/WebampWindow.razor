@inherits WindowAppBase

<div class="webamp-window" role="application" aria-label="@L["PlayerLabel"]">
    @* Webamp renders into this element (renderInto): its three windows, on the window's dark backdrop. *@
    <div class="webamp-surface" @ref="_surface"></div>
    @if (_status is not null)
    {
        <p class="app-status @(_failed ? "failed" : string.Empty)" role="@(_failed ? "alert" : "status")">@_status</p>
    }
</div>
